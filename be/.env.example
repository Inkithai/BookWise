# ──────────────────────────────────────────────────────────
# BookWise – Backend Environment Configuration
# ──────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
#   cp .env.example .env
#   php artisan key:generate
#   php artisan passport:keys
# ──────────────────────────────────────────────────────────

# ─── Application ──────────────────────────────────────────
APP_NAME=BookWise
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001
APP_TIMEZONE=Asia/Colombo

# ─── Database ─────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bookwise
DB_USERNAME=root
DB_PASSWORD=

# ─── Cache / Queue / Session ──────────────────────────────
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── Mail ─────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@bookwise.lk
MAIL_FROM_NAME="${APP_NAME}"
MAIL_SUPPORT_RECIPIENTS=support@bookwise.com

# ─── Authentication ───────────────────────────────────────
# Passport keys are generated by: php artisan passport:keys
PASSPORT_PRIVATE_KEY=
PASSPORT_PUBLIC_KEY=
# Bearer token lifetime (minutes)
TOKEN_LIFETIME=525600

# ─── Google OAuth (optional) ─────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
FRONTEND_URL=http://localhost:3000

# ─── Stripe (optional — for subscriptions) ────────────────
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET_SUB=

# ─── BookWise Sync (optional — cross-platform sync) ──────
BOOKWISE_API_URL=http://localhost:8001
BOOKWISE_APP_API_KEY=

# ─── Subscription Plans ───────────────────────────────────
# Default currency for billing
SUBSCRIPTION_CURRENCY=LKR

# ─── Logging ──────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_LEVEL=debug

# ─── File Storage ─────────────────────────────────────────
FILESYSTEM_DISK=local
# For S3:
# FILESYSTEM_DISK=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=ap-south-1
# AWS_BUCKET=

# ─── Swagger / API Docs ──────────────────────────────────
L5_SWAGGER_GENERATE_ALWAYS=true
L5_SWAGGER_CONST_HOST=http://localhost:8001/api
