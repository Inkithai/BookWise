# ──────────────────────────────────────────────────────────
# BookWise – Frontend Environment Configuration (Next.js 16)
# ──────────────────────────────────────────────────────────
# Copy this file to .env.local for development:
#   cp .env.example .env.local
#
# On Vercel, set the same variables under
# Project → Settings → Environment Variables.
#
# NOTE: NEXT_PUBLIC_* values are inlined into the browser bundle
# at build time. Never put secrets (API keys with server rights,
# DB credentials, …) in a NEXT_PUBLIC_ variable.
# ──────────────────────────────────────────────────────────

# ─── Backend API ─────────────────────────────────────────
# Root URL of the Laravel API — WITHOUT a trailing /api or slash.
# Services append /api/v1 themselves.
# Local:    http://localhost:8001
# Render:   https://<your-app>.onrender.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001

# Only needed if the invoice endpoints live on a different host
# (defaults to NEXT_PUBLIC_API_BASE_URL when empty)
NEXT_PUBLIC_INVOICE_API_URL=

# ─── Auth / storage keys ─────────────────────────────────
# localStorage keys used for the OAuth2 bearer token & user object
NEXT_PUBLIC_TOKEN_STORAGE_KEY=authToken
NEXT_PUBLIC_USER_STORAGE_KEY=authUser

# ─── Stripe (publishable key only!) ──────────────────────
NEXT_PUBLIC_STRIPE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ─── BookWise cross-platform sync (optional) ─────────────
# Used by the server-side /api/sync/* Next routes.
# On Vercel prefer the NON-public names BOOKWISE_API_URL / BOOKWISE_APP_API_KEY.
NEXT_PUBLIC_BOOKWISE_API_URL=
NEXT_PUBLIC_BOOKWISE_APP_API_KEY=

# ─── URLs used in shared links / redirects ───────────────
NEXT_PUBLIC_REDIRECT_BASE_URL=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_INVOICE_FRONTEND_URL=

# ─── Google OAuth ────────────────────────────────────────
# Configured on the BACKEND (GOOGLE_CLIENT_ID / GOOGLE_REDIRECT_URI).
# GOOGLE_REDIRECT_URI must point at this app:
#   https://<your-vercel-app>/auth/google/callback

# ─── Analytics (optional) ────────────────────────────────
NEXT_PUBLIC_GOOGLE_ADS_ID=

# ─── Company profile shown in footer/invoices ────────────
NEXT_PUBLIC_COMPANY_NAME=
NEXT_PUBLIC_COMPANY_REGISTRATION=
NEXT_PUBLIC_COMPANY_VAT=
NEXT_PUBLIC_COMPANY_ADDRESS=
NEXT_PUBLIC_COMPANY_EMAIL=
NEXT_PUBLIC_COMPANY_PHONE=
